---
import '../styles/style.css';
---
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LAMO C.A. — Catálogo de Cauchos y Accesorios</title>
    <meta name="description"
        content="Catálogo oficial de LAMO C.A. Autoperiquitos y Cauchos. Encuentra cauchos, rines, lubricantes, baterías y más al mejor precio.">
    <link rel="icon" type="image/png" href="/icon.PNG">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Barlow+Condensed:wght@600;700;800&family=Chakra+Petch:ital,wght@0,500;0,600;0,700;1,700&display=swap"
        rel="stylesheet">

</head>

<body class="app-wizard-mode">

    <!-- ══════════ NAVBAR ══════════ -->
    <nav class="navbar">
        <div class="navbar-inner">
    <!--
    ══════════════════════════════════════════════════════════════════
    LOGOS TIENDAS ALIADAS — GUARDADOS PARA USO FUTURO
    (Sistema "Hacer Cita" — ver AGENTS.md §8)
    ══════════════════════════════════════════════════════════════════

    Logo LAMO C.A.:
    <div class="brand-css-logo">
        <div class="brand-name-css">
            <span class="brand-lamo">LAMO</span>
            <span class="brand-ca">C.A.</span>
        </div>
        <span class="brand-tag-css">AUTOPERIQUITOS Y CAUCHOS</span>
    </div>

    Divisor:
    <div class="brand-divider" aria-hidden="true"></div>

    Logo Servi Cauchos Libertador C.A.:
    <div class="brand-css-logo servi-logo">
        <div class="servi-name-css">
            <span class="cauchos-word">LIBERTADOR</span>
        </div>
        <span class="servi-tag-css">
            <span class="servi-tag-white">Servi</span>
            <span class="servi-tag-orange">Cauchos C.A.</span>
        </span>
    </div>
    ══════════════════════════════════════════════════════════════════
    -->

            <!-- ── Logo principal TUSCAUCHOS.com ── -->
            <div class="brand-css-logo">
                <div class="brand-name-css">
                    <span class="brand-tus">TUS</span><span class="brand-cauchos">CAUCHOS</span><span class="brand-com">.com</span>
                </div>
                <span class="brand-tag-css">TU TIENDA DE CAUCHOS ONLINE</span>
            </div>

            <nav class="nav-links" id="category-list">
                <a href="#" class="nav-link filter-item active" data-value="">Inicio</a>
                <a href="#" class="nav-link filter-item" data-value="Cauchos">Cauchos</a>
                <a href="#" class="nav-link filter-item" data-value="Rines">Rines</a>
                <a href="#" class="nav-link filter-item" data-value="Baterías">Baterías</a>
                <a href="#" class="nav-link filter-item" data-value="Lubricantes">Lubricantes</a>
                <a href="#" class="nav-link filter-item" data-value="Refrigerantes">Refrigerantes</a>
                <a href="#" class="nav-link filter-item" data-value="Pastillas">Pastillas de Frenos</a>
                <a href="#" class="nav-link filter-item" data-value="Tripas/Protectores">Tripas y Protectores</a>
                <a href="#" class="nav-link filter-item" data-value="Forros">Forros de Asiento</a>
            </nav>
        </div>
    </nav>

    <!-- ══════════ SEARCH BAR ══════════ -->
    <div class="topbar">
        <div class="topbar-inner">
            <div class="search-wrap">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" id="search" class="search-input" placeholder="Buscar por marca, medida, producto…">
            </div>
        </div>
    </div>

    <!-- ══════════ ASISTENTE INTERACTIVO MÓVIL (WIZARD 3 PASOS) ══════════ -->
    <section class="wizard-section" id="interactive-wizard">
        <div class="wizard-container">
            <!-- Header del Asistente (Estilo App Cashea) -->
            <div class="wizard-hero">
                <div class="brand-css-logo wizard-logo-center">
                    <div class="brand-name-css">
                        <span class="brand-tus">TUS</span><span class="brand-cauchos">CAUCHOS</span><span class="brand-com">.com</span>
                    </div>
                    <span class="brand-tag-css">TU TIENDA DE CAUCHOS ONLINE</span>
                </div>

                <!-- Indicador visual de los 3 pasos -->
                <div class="wizard-stepper">
                    <div class="stepper-item active" id="step-node-1">
                        <span class="stepper-num">1</span>
                        <span class="stepper-label">¿Qué buscas?</span>
                    </div>
                    <div class="stepper-divider" id="step-line-1"></div>
                    <div class="stepper-item" id="step-node-2">
                        <span class="stepper-num">2</span>
                        <span class="stepper-label">Tu Vehículo</span>
                    </div>
                    <div class="stepper-divider" id="step-line-2"></div>
                    <div class="stepper-item" id="step-node-3">
                        <span class="stepper-num">3</span>
                        <span class="stepper-label">Tus Medidas</span>
                    </div>
                </div>
            </div>

            <!-- PASO 1: ¿Qué buscas? -->
            <div class="wizard-panel active" id="wizard-step-1">
                <div class="panel-head">
                    <h2 class="panel-question">1. ¿Qué estás buscando hoy?</h2>
                    <p class="panel-desc">Toca para seleccionar una categoría</p>
                </div>
                <div class="cat-grid" id="cat-selection-grid">
                    <!-- Cauchos -->
                    <button type="button" class="cat-card active" data-cat="Cauchos">
                        <span class="cat-card-icon"><img src="/icons/cat-cauchos.jpg" alt="Cauchos" loading="eager"></span>
                        <span class="cat-card-title">Cauchos</span>
                        <span class="cat-card-badge">✓</span>
                    </button>
                    <!-- Rines -->
                    <button type="button" class="cat-card" data-cat="Rines">
                        <span class="cat-card-icon"><img src="/icons/cat-rines.jpg" alt="Rines" loading="eager"></span>
                        <span class="cat-card-title">Rines</span>
                        <span class="cat-card-badge">✓</span>
                    </button>
                    <!-- Baterías -->
                    <button type="button" class="cat-card" data-cat="Baterías">
                        <span class="cat-card-icon"><img src="/icons/cat-baterias.jpg" alt="Baterías" loading="eager"></span>
                        <span class="cat-card-title">Baterías</span>
                        <span class="cat-card-badge">✓</span>
                    </button>
                    <!-- Forros -->
                    <button type="button" class="cat-card" data-cat="Forros">
                        <span class="cat-card-icon"><img src="/icons/cat-forros.jpg" alt="Forros" loading="eager"></span>
                        <span class="cat-card-title">Forros</span>
                        <span class="cat-card-badge">✓</span>
                    </button>
                    <!-- Lubricantes -->
                    <button type="button" class="cat-card" data-cat="Lubricantes">
                        <span class="cat-card-icon"><img src="/icons/cat-lubricantes.jpg" alt="Lubricantes" loading="eager"></span>
                        <span class="cat-card-title">Lubricantes</span>
                        <span class="cat-card-badge">✓</span>
                    </button>
                    <!-- Refrigerantes -->
                    <button type="button" class="cat-card" data-cat="Refrigerantes">
                        <span class="cat-card-icon"><img src="/icons/cat-refrigerantes.jpg" alt="Refrigerantes" loading="eager"></span>
                        <span class="cat-card-title">Refrigerantes</span>
                        <span class="cat-card-badge">✓</span>
                    </button>
                    <!-- Pastillas -->
                    <button type="button" class="cat-card" data-cat="Pastillas">
                        <span class="cat-card-icon"><img src="/icons/cat-pastillas.jpg" alt="Pastillas de Freno" loading="eager"></span>
                        <span class="cat-card-title">Pastillas Freno</span>
                        <span class="cat-card-badge">✓</span>
                    </button>
                    <!-- Tripas y Protectores -->
                    <button type="button" class="cat-card" data-cat="Tripas/Protectores">
                        <span class="cat-card-icon"><img src="/icons/cat-tripas.jpg" alt="Tripas y Protectores" loading="eager"></span>
                        <span class="cat-card-title">Tripas y Prot.</span>
                        <span class="cat-card-badge">✓</span>
                    </button>
                </div>
                <div class="panel-foot">
                    <button type="button" class="btn-wizard-action" id="btn-wizard-to-step2">
                        <span>Siguiente: Elegir Vehículo</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                </div>
                <div class="wizard-skip-row">
                    <button type="button" class="btn-skip-wizard" id="btn-skip-wizard">
                        O explorar todo el catálogo directamente ›
                    </button>
                </div>
            </div>

            <!-- PASO 2: Tu Vehículo -->
            <div class="wizard-panel" id="wizard-step-2">
                <div class="panel-head">
                    <div class="panel-nav-row">
                        <button type="button" class="btn-panel-back" id="btn-back-to-step1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                            <span>Volver</span>
                        </button>
                        <span class="panel-step-tag">Paso 2 de 3</span>
                    </div>
                    <h2 class="panel-question">2. ¿Para qué vehículo buscas?</h2>
                    <p class="panel-desc">Elige la marca y modelo para darte la medida exacta de tu carro</p>
                </div>

                <div class="vehicle-finder-card">
                    <div class="quick-brands-label">Marcas más populares:</div>
                    <div class="quick-brands-grid" id="v-quick-brands">
                        <button type="button" class="brand-pill-btn" data-brand="Chevrolet">Chevrolet</button>
                        <button type="button" class="brand-pill-btn" data-brand="Toyota">Toyota</button>
                        <button type="button" class="brand-pill-btn" data-brand="Ford">Ford</button>
                        <button type="button" class="brand-pill-btn" data-brand="Chery">Chery</button>
                        <button type="button" class="brand-pill-btn" data-brand="Fiat">Fiat</button>
                        <button type="button" class="brand-pill-btn" data-brand="Hyundai">Hyundai</button>
                        <button type="button" class="brand-pill-btn" data-brand="Renault">Renault</button>
                        <button type="button" class="brand-pill-btn" data-brand="Jeep">Jeep</button>
                    </div>

                    <div class="vehicle-selects-grid">
                        <div class="v-field">
                            <label for="wizard-brand-select">Marca:</label>
                            <select id="wizard-brand-select" class="v-select">
                                <option value="">Selecciona Marca...</option>
                            </select>
                        </div>
                        <div class="v-field">
                            <label for="wizard-model-select">Modelo:</label>
                            <select id="wizard-model-select" class="v-select" disabled>
                                <option value="">Primero elige Marca...</option>
                            </select>
                        </div>
                    </div>

                    <div class="manual-fallback-row">
                        <span>¿No está tu carro?</span>
                        <button type="button" id="btn-manual-size-toggle" class="link-btn">Buscar directo por medida o Rin ›</button>
                    </div>
                </div>

                <!-- Desplegable para quien no encuentra su carro -->
                <div class="manual-drawer hidden" id="manual-size-drawer">
                    <p class="drawer-hint">Selecciona el Rin de tu caucho directamente:</p>
                    <div class="manual-rim-chips" id="manual-rim-chips">
                        <button type="button" class="rim-chip" data-rim="13">R13</button>
                        <button type="button" class="rim-chip" data-rim="14">R14</button>
                        <button type="button" class="rim-chip" data-rim="15">R15</button>
                        <button type="button" class="rim-chip" data-rim="16">R16</button>
                        <button type="button" class="rim-chip" data-rim="17">R17</button>
                        <button type="button" class="rim-chip" data-rim="18">R18</button>
                    </div>
                </div>
            </div>

            <!-- PASO 3: Medidas Recomendadas -->
            <div class="wizard-panel" id="wizard-step-3">
                <div class="panel-head">
                    <div class="panel-nav-row">
                        <button type="button" class="btn-panel-back" id="btn-back-to-step2">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                            <span>Cambiar Carro</span>
                        </button>
                        <span class="panel-step-tag">Paso 3 de 3</span>
                    </div>
                    <h2 class="panel-question" id="step3-vehicle-title">Medidas para tu Vehículo</h2>
                    <p class="panel-desc">Toca tu medida para ver los cauchos disponibles en stock:</p>
                </div>

                <div class="recommended-grid" id="recommended-sizes-grid">
                    <!-- Botones de medidas inyectados dinámicamente -->
                </div>
            </div>

            <!-- Tiendas Aliadas -->
            <div class="wizard-partners">
                <span class="wizard-partners-label">Tiendas Aliadas</span>
                <div class="wizard-partners-logos">
                    <div class="wizard-partner-chip">
                        <img src="/logos/lamo.png" alt="LAMO C.A." class="wizard-partner-logo" />
                    </div>
                    <div class="wizard-partner-chip">
                        <img src="/logos/libertador.png" alt="Servicauchos Libertador" class="wizard-partner-logo" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════ MAIN LAYOUT ══════════ -->
    <div class="layout">

        <!-- ── SIDEBAR ── -->
        <aside class="sidebar">
            <div class="sidebar-section" id="tire-filters">
                <h3 class="sidebar-title">Rin</h3>
                <ul class="filter-list" id="rim-list">
                    <li class="filter-item active" data-value="">Todos</li>
                    <li class="filter-item" data-value="13">R13</li>
                    <li class="filter-item" data-value="14">R14</li>
                    <li class="filter-item" data-value="15">R15</li>
                    <li class="filter-item" data-value="16">R16</li>
                    <li class="filter-item" data-value="17">R17</li>
                    <li class="filter-item" data-value="18">R18</li>
                    <li class="filter-item" data-value="20">R20</li>
                    <li class="filter-item" data-value="24">R24</li>
                </ul>
            </div>

            <div class="sidebar-section" id="terrain-filter-section">
                <h3 class="sidebar-title">Tipo de Terreno</h3>
                <ul class="filter-list" id="terrain-list">
                    <li class="filter-item active" data-value="">Todos</li>
                    <li class="filter-item" data-value="HT">HT — Highway Terrain</li>
                    <li class="filter-item" data-value="AT">AT — All Terrain</li>
                    <li class="filter-item" data-value="MT">MT — Mud Terrain</li>
                </ul>
            </div>

            <div class="sidebar-section" id="forros-sidebar-section" style="display: none;">
                <h3 class="sidebar-title">Vehículo (Forros)</h3>
                <div class="sidebar-field" style="margin-bottom: 12px;">
                    <label class="sidebar-label" for="forros-side-brand">Marca</label>
                    <select id="forros-side-brand" class="finder-select" style="width: 100%;">
                        <option value="">Todas las Marcas</option>
                    </select>
                </div>
                <div class="sidebar-field">
                    <label class="sidebar-label" for="forros-side-model">Modelo</label>
                    <select id="forros-side-model" class="finder-select" style="width: 100%;" disabled>
                        <option value="">Todos los Modelos</option>
                    </select>
                </div>
            </div>

            <button id="reset-btn" class="btn-reset" style="display:none;">Eliminar Filtros</button>
        </aside>

        <!-- ══════════ MOBILE FILTER BAR (chips horizontales) ══════════ -->
        <div class="mobile-filter-bar" id="mobile-filter-bar">
            <!-- Categorías -->
            <div class="mfb-row" id="mfb-cat-row">
                <div class="mfb-scroll">
                    <!-- Todo -->
                    <button class="mfb-chip active" data-filter="category" data-value="">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                            <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                        </svg>
                        Todo
                    </button>
                    <!-- Cauchos -->
                    <button class="mfb-chip" data-filter="category" data-value="Cauchos">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/>
                            <line x1="12" y1="3" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="21"/>
                            <line x1="3" y1="12" x2="8" y2="12"/><line x1="16" y1="12" x2="21" y2="12"/>
                        </svg>
                        Cauchos
                    </button>
                    <!-- Rines -->
                    <button class="mfb-chip" data-filter="category" data-value="Rines">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/>
                            <line x1="12" y1="3" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="21"/>
                            <line x1="3" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="21" y2="12"/>
                            <line x1="5.6" y1="5.6" x2="9.9" y2="9.9"/><line x1="14.1" y1="14.1" x2="18.4" y2="18.4"/>
                            <line x1="18.4" y1="5.6" x2="14.1" y2="9.9"/><line x1="9.9" y1="14.1" x2="5.6" y2="18.4"/>
                        </svg>
                        Rines
                    </button>
                    <!-- Baterías -->
                    <button class="mfb-chip" data-filter="category" data-value="Baterías">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <rect x="2" y="7" width="18" height="11" rx="2"/>
                            <path d="M20 11h2v3h-2"/>
                            <line x1="7" y1="12" x2="10" y2="12"/><line x1="8.5" y1="10.5" x2="8.5" y2="13.5"/>
                            <line x1="13" y1="12" x2="15" y2="12"/>
                        </svg>
                        Baterías
                    </button>
                    <!-- Lubricantes -->
                    <button class="mfb-chip" data-filter="category" data-value="Lubricantes">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M12 2C12 2 6 10 6 14a6 6 0 0 0 12 0c0-4-6-12-6-12z"/>
                        </svg>
                        Lubricantes
                    </button>
                    <!-- Refrigerantes -->
                    <button class="mfb-chip" data-filter="category" data-value="Refrigerantes">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1"/>
                        </svg>
                        Refrigerantes
                    </button>
                    <!-- Pastillas -->
                    <button class="mfb-chip" data-filter="category" data-value="Pastillas">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/>
                            <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                        </svg>
                        Pastillas
                    </button>
                    <!-- Tripas -->
                    <button class="mfb-chip" data-filter="category" data-value="Tripas/Protectores">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="M8 12a4 4 0 0 0 8 0"/>
                        </svg>
                        Tripas
                    </button>
                    <!-- Forros -->
                    <button class="mfb-chip" data-filter="category" data-value="Forros">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M5 3h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>
                            <path d="M3 12h18v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7z"/>
                        </svg>
                        Forros
                    </button>
                </div>
            </div>
            <!-- Rin (sólo visible cuando categoría es Cauchos/Rines/vacía) -->
            <div class="mfb-row hidden" id="mfb-rim-row">
                <div class="mfb-scroll">
                    <span class="mfb-label">Rin</span>
                    <button class="mfb-chip active" data-filter="rim" data-value="">Todos</button>
                    <button class="mfb-chip" data-filter="rim" data-value="13">R13</button>
                    <button class="mfb-chip" data-filter="rim" data-value="14">R14</button>
                    <button class="mfb-chip" data-filter="rim" data-value="15">R15</button>
                    <button class="mfb-chip" data-filter="rim" data-value="16">R16</button>
                    <button class="mfb-chip" data-filter="rim" data-value="17">R17</button>
                    <button class="mfb-chip" data-filter="rim" data-value="18">R18</button>
                    <button class="mfb-chip" data-filter="rim" data-value="20">R20</button>
                    <button class="mfb-chip" data-filter="rim" data-value="24">R24</button>
                </div>
            </div>
            <!-- Terreno (sólo cuando categoría es Cauchos y rin ≥15) -->
            <div class="mfb-row hidden" id="mfb-terrain-row">
                <div class="mfb-scroll">
                    <span class="mfb-label">Terreno</span>
                    <button class="mfb-chip active" data-filter="terrain" data-value="">Todos</button>
                    <button class="mfb-chip" data-filter="terrain" data-value="HT">HT</button>
                    <button class="mfb-chip" data-filter="terrain" data-value="AT">AT</button>
                    <button class="mfb-chip" data-filter="terrain" data-value="MT">MT</button>
                </div>
            </div>
        </div>

        <!-- ── CONTENT ── -->
        <main class="content">
            <!-- Barra fija de Vehículo Activo en Catálogo -->
            <div class="active-vehicle-bar hidden" id="active-vehicle-bar">
                <div class="active-v-content">
                    <span class="active-v-emoji">🚗</span>
                    <div class="active-v-meta">
                        <span class="active-v-name" id="active-v-title">Vehículo</span>
                        <span class="active-v-measure" id="active-v-sub">Medida activa</span>
                    </div>
                </div>
                <button type="button" class="btn-edit-vehicle" id="btn-change-vehicle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    <span>Cambiar Vehículo</span>
                </button>
            </div>

            <!-- ══════════ BUSCADOR DE FORROS POR VEHÍCULO ══════════ -->
            <div id="forros-finder-banner" class="forros-finder-banner" style="display: none;">
                <div class="forros-finder-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-2 4C1.2 12.3 1 12.6 1 13v3c0 .6.4 1 1 1h2"/>
                        <circle cx="7" cy="17" r="2"/>
                        <circle cx="17" cy="17" r="2"/>
                    </svg>
                    <span>Buscar Forros por Vehículo</span>
                </div>
                <div class="forros-finder-grid">
                    <div class="forros-field">
                        <label for="forros-brand-select">Marca:</label>
                        <select id="forros-brand-select" class="finder-select">
                            <option value="">Todas las Marcas</option>
                        </select>
                    </div>
                    <div class="forros-field">
                        <label for="forros-model-select">Modelo:</label>
                        <select id="forros-model-select" class="finder-select" disabled>
                            <option value="">Todos los Modelos</option>
                        </select>
                    </div>
                    <button type="button" id="forros-reset-btn" class="btn-forros-reset" style="display: none;">
                        Limpiar Filtro
                    </button>
                </div>
            </div>

            <!-- ══════════ BUSCADOR DE TRIPAS POR RIN ══════════ -->
            <div id="tripas-finder-banner" class="forros-finder-banner" style="display: none;">
                <div class="forros-finder-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                        <circle cx="12" cy="12" r="10"/>
                        <circle cx="12" cy="12" r="4"/>
                        <path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>
                    </svg>
                    <span>Buscar Tripas y Protectores por Rin</span>
                </div>
                <div class="forros-finder-grid">
                    <div class="forros-field">
                        <label for="tripas-rim-select">Rin:</label>
                        <select id="tripas-rim-select" class="finder-select">
                            <option value="">Todos los Rines</option>
                        </select>
                    </div>
                    <button type="button" id="tripas-reset-btn" class="btn-forros-reset" style="display: none;">
                        Limpiar Filtro
                    </button>
                </div>
            </div>

            <div class="content-header">
                <span id="result-count" class="result-count">— productos</span>
            </div>

            <div id="catalog-container" class="product-grid"></div>

            <div id="no-results" class="no-results hidden">
                <div class="no-results-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="40" height="40">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
                <p class="no-results-msg">No hay stock para esta búsqueda.</p>
                <button id="reset-no-results-btn" class="btn-reset-inline">Eliminar Filtros</button>
            </div>
        </main>

    </div>

    <!-- ══════════ ZOOM MODAL (AMAZON STYLE) ══════════ -->
    <div id="image-zoom-modal" class="zoom-modal hidden">
        <div class="zoom-modal-backdrop" id="zoom-modal-backdrop"></div>
        <div class="zoom-modal-content">
            <button id="zoom-modal-close" class="zoom-modal-close" aria-label="Cerrar">&times;</button>
            <div class="zoom-modal-body">
                <div class="zoom-img-container" id="zoom-img-container">
                    <img id="zoom-target-img" src="" alt="Zoom" class="zoom-img" />
                    <div class="zoom-hint">Toca o acerca para ampliar</div>
                </div>
                <div class="zoom-modal-info">
                    <div class="zoom-modal-header">
                        <div class="zoom-title-group">
                            <span id="zoom-modal-brand" class="zoom-brand"></span>
                            <h3 id="zoom-modal-title" class="zoom-title"></h3>
                            <div id="zoom-modal-size" class="zoom-size"></div>
                        </div>
                        <div id="zoom-modal-stock" class="zoom-stock"></div>
                    </div>
                    <div id="zoom-modal-desc-box" class="zoom-modal-desc-box hidden">
                        <div class="zoom-desc-header">
                            <svg class="zoom-desc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <span>Sobre esta marca</span>
                        </div>
                        <p id="zoom-modal-desc" class="zoom-desc-text"></p>
                    </div>
                    <div class="zoom-modal-price-wrap">
                        <div id="zoom-modal-price" class="zoom-price"></div>
                    </div>
                    <a id="zoom-modal-wa-btn" href="#" target="_blank" class="btn-apartar zoom-wa-btn">Apartar por WhatsApp</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════ MOBILE BOTTOM NAV ══════════ -->
    <nav class="mobile-bottom-nav">
        <a href="#" class="mob-nav-item" id="mob-nav-home">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Inicio</span>
        </a>
        <a href="#" class="mob-nav-item" id="mob-nav-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Buscar</span>
        </a>
        <a href="#" class="mob-nav-item" id="mob-nav-cats">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            <span>Categorías</span>
        </a>
    </nav>

    <script src="../scripts/app.js"></script>
</body>

</html>